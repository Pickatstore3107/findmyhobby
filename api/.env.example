# Copy to .env. Never commit .env.
DATABASE_URL=mysql://root:localdev@127.0.0.1:3307/findmyhobby
OWNER_EMAILS=
GOOGLE_CLIENT_IDS=
ADMIN_ORIGIN=http://localhost:3000

# Image uploads (set on the server; local development can leave these empty)
S3_BUCKET=
AWS_REGION=ap-southeast-2
IMAGE_BASE_URL=

# Where members pay by UPI
UPI_ID=
UPI_NAME="FindMyHobby Club"

# Razorpay (Dashboard → Settings → API Keys). Test keys start with rzp_test_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=
