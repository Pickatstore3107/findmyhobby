# /etc/systemd/system/fmh-api.service — keeps the API running and restarts it if it ever stops.
[Unit]
Description=FindMyHobby API
After=network-online.target
Wants=network-online.target

[Service]
User=fmh
WorkingDirectory=/srv/fmh/app/api
# Settings and secrets: readable only by root and the fmh user (chmod 640).
EnvironmentFile=/etc/fmh/api.env
ExecStart=/srv/fmh/app/api/node_modules/.bin/tsx src/server.ts
Restart=always
RestartSec=3
# Hardening: the API can only write to its own temp space.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
