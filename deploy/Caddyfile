# Caddy gets and renews HTTPS certificates automatically (Let's Encrypt).
{
	email akshaybouroju@gmail.com
}

# Website pages, the admin console (/console) and the API for the console (/api)
findmyhobby.in, www.findmyhobby.in {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	@www host www.findmyhobby.in
	redir @www https://findmyhobby.in{uri} permanent

	handle_path /api/* {
		reverse_proxy 127.0.0.1:4000
	}
	handle /console* {
		# Strict rules for the staff console: only our own scripts, plus Google sign-in. No inline scripts, no framing.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.supabase.co https://lh3.googleusercontent.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
			Cross-Origin-Opener-Policy "same-origin-allow-popups"
			Cache-Control "no-store"
		}
		@assets path /console/assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		root * /srv/fmh/www
		try_files {path} /console/index.html
		file_server
	}
	handle {
		root * /srv/fmh/www
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}

# API for the phone app, the payment page and Razorpay webhooks
api.findmyhobby.in {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	reverse_proxy 127.0.0.1:4000
}
