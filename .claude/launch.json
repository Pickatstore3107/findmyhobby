{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "api",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "admin",
        "dev"
      ],
      "port": 5180,
      "url": "http://localhost:5180"
    },
    {
      "name": "website",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5190",
        "--bind",
        "127.0.0.1",
        "--directory",
        "website"
      ],
      "port": 5190
    }
  ]
}